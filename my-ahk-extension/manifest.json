{
  "manifest_version": 3,
  "name": "AHK Text Selector",
  "version": "1.0",
  "description": "Select text and click a button to run a local AutoHotkey script.",
  "permissions": [
    "activeTab",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": []
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
